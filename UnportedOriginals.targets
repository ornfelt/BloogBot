<Project>

  <!-- TEMPORARY PORT SCAFFOLDING - not part of the finished port.

       BloogBot_net9 was created as a clone of the .NET Framework source repository rather than
       as an empty `git init` repository, so every source file that has not been ported yet is
       still sitting in this working tree. SDK-style projects glob every `.cs` under their own
       directory, so those .NET Framework originals would be compiled alongside the ported files
       and the solution would not build.

       The intended fix is to delete them; they are tracked and unmodified, so `git restore` puts
       any of them back. That deletion is currently blocked by this session's permission policy,
       so they are excluded from compilation instead - same effect on the build, nothing removed
       from disk.

       A file is listed here when it also exists at the same path in the source tree AND its first
       line is not `// Ported from BloogBot/...`. Files that exist only here - new code the port
       adds, such as Fasm.NET/FasmNet.cs - are never listed and always compile. This file is
       regenerated by every run of the `bloogbot-net9-port` skill and shrinks as files are ported;
       when the port is complete it is empty and both it and Directory.Build.targets are deleted.

       Imported from Directory.Build.targets, not Directory.Build.props, on purpose: the SDK's
       default `Compile` glob runs after Directory.Build.props, so a Remove there would match
       nothing. -->

  <ItemGroup Condition="'$(MSBuildProjectExtension)'=='.csproj'">
    <Compile Remove="$(MSBuildThisFileDirectory)AfflictionWarlockBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)ArcaneMageBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)ArmsWarriorBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BackstabRogueBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BalanceDruidBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BeastmasterHunterBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBotTests\NavigationTests.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBotTests\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBot\Properties\Resources.Designer.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBot\Properties\Settings.Designer.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBot\UI\App.xaml.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBot\UI\BotService.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBot\UI\CommandHandler.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBot\UI\MainViewModel.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)BloogBot\UI\MainWindow.xaml.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)Bootstrapper\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)CombatRogueBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)ElementalShamanBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)EnhancementShamanBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)FeralDruidBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)FrostMageBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)FuryWarriorBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)ProtectionPaladinBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)ProtectionWarriorBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)RetributionPaladinBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)ShadowPriestBot\Properties\AssemblyInfo.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)TestBot.cs\Properties\AssemblyInfo.cs" />
  </ItemGroup>

</Project>
