<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0-windows rather than the plain net9.0 the skill's project table gives, because this
         project references BloogBot, which is net9.0-windows. UseWPF and UseWindowsForms stay off,
         so the WPF and WinForms assemblies are still not referenced and a WPF type leaking in here
         still does not compile - which is what the plain-net9.0 rule was for. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>BloogBot.UI</RootNamespace>
    <AssemblyName>BloogBot.UI.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MainWindow.xaml.cs calls BotService.Run, and BotService is internal here exactly as
         it was in the original. Handing the internals to the two shells keeps that modifier
         as the original wrote it. -->
    <InternalsVisibleTo Include="BloogBot.UI.Wpf" />
    <InternalsVisibleTo Include="BloogBot.UI.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <!-- StreamJsonRpc 2.24.84, the same version as the original packages.config: BotService.cs.
         The package already shipped netstandard2.0, so the source is unchanged. -->
    <PackageReference Include="StreamJsonRpc" Version="2.24.84" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BloogBot.UI.Abstractions\BloogBot.UI.Abstractions.csproj" />
    <ProjectReference Include="..\BloogBot\BloogBot.csproj" />
  </ItemGroup>

</Project>
