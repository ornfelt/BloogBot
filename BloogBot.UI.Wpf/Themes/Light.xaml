<!-- Added by the .NET 9 port - no counterpart in BloogBot, whose window used the stock WPF chrome.
     The keys and their values are fixed by the skill's theming table and are identical in all four
     theme files across the two shells; only the values differ between Dark and Light. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFCCCCCC"/>
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="MutedForegroundBrush" Color="#FF6E6E6E"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF107C10"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9D5D00"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFC42B1C"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#FFCCE4F7"/>
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TabInactiveBackgroundBrush" Color="#FFECECEC"/>

    <!-- The implicit control styles that used to sit here, duplicated in both theme
         files, now live once in Themes/Controls.xaml. They are theme-independent: they
         only name the keys above, so App.xaml merges that dictionary once and
         WpfThemeService swaps only this one. The Avalonia shell has had the same split
         between Themes/Dark.axaml and Themes/Controls.axaml from the start. -->

</ResourceDictionary>
