<Project>

  <!-- TEMPORARY PORT SCAFFOLDING - not part of the finished port.

       BloogBot_net9 was created as a clone of the .NET Framework source repository rather than
       as an empty `git init` repository, so every source file that has not been ported yet is
       still sitting in this working tree. SDK-style projects glob every `.cs` under their own
       directory, so those .NET Framework originals would be compiled alongside the ported files
       and the solution would not build.

       The intended fix is to delete them; they are tracked and unmodified, so `git restore` puts
       any of them back. That deletion is currently blocked by this session's permission policy,
       so they are excluded from compilation instead - same effect on the build, nothing removed
       from disk.

       A file counts as ported when its first line is `// Ported from BloogBot/...`. This file is
       regenerated by every run of the `bloogbot-net9-port` skill and shrinks as files are ported;
       when the port is complete it is empty and both it and Directory.Build.targets are deleted.

       Imported from Directory.Build.targets, not Directory.Build.props, on purpose: the SDK's
       default `Compile` glob runs after Directory.Build.props, so a Remove there would match
       nothing. -->

  <ItemGroup Condition="'$(MSBuildProjectExtension)'=='.csproj'">
    <Compile Remove="$(MSBuildThisFileDirectory)AfflictionWarlockBot\AfflictionWarlockBot.cs" />
    <Compile Remove="$(MSBuildThisFileDirectory)AfflictionWarlockBot\BuffSelfState.cs" />
