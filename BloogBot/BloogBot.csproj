<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>BloogBot</RootNamespace>
    <AssemblyName>BloogBot</AssemblyName>
    <!-- The original was a WinExe that Loader.dll ran through ExecuteInDefaultAppDomain.
         hostfxr loads BloogBot.dll instead and needs BloogBot.runtimeconfig.json plus the
         dependency closure next to it - hence EnableDynamicLoading. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Newtonsoft.Json 13.0.3 (same as packages.config): Game/Position.cs, BotSettings.cs -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Discord.Net 3.x: DiscordClientWrapper.cs. The original referenced Discord.Net 2.2.0,
         whose assemblies are net461-only and cannot be referenced from net9.0. -->
    <PackageReference Include="Discord.Net" Version="3.17.4" />
    <!-- System.Data.SQLite.Core: SqliteRepository.cs. Replaces the System.Data.SQLite reference
         from packages.config; same System.Data.SQLite namespace, so the source is unchanged. -->
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <!-- System.Data.SqlClient: SqlRepository.cs, TSqlRepository.cs. On .NET Framework this was a
         BCL assembly reference; on .NET 9 the same namespace ships as a package. -->
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Replaces the prebuilt Fasm.NET.dll reference from the original csproj: that assembly is
         mixed-mode C++/CLI built for net461 and cannot load on .NET 9. Same namespace and members,
         so MemoryManager.cs is unchanged. -->
    <ProjectReference Include="..\Fasm.NET\Fasm.NET.csproj" />
    <ProjectReference Include="..\BloogBot.UI.Core\BloogBot.UI.Core.csproj" />
    <ProjectReference Include="..\BloogBot.UI.Wpf\BloogBot.UI.Wpf.csproj" Condition="'$(Ui)'=='Wpf'" />
    <ProjectReference Include="..\BloogBot.UI.Avalonia\BloogBot.UI.Avalonia.csproj" Condition="'$(Ui)'=='Avalonia'" />
  </ItemGroup>

  <!-- Same copy rules as the original csproj: settings PreserveNewest, schemas Always. -->
  <ItemGroup>
    <None Update="bootstrapperSettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="botSettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="TSqlSchema.SQL" CopyToOutputDirectory="Always" />
    <None Update="SqliteSchema.SQL" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
