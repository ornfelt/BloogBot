  <PropertyGroup>
    <!-- Local customizations on top of upstream BloogBot. Set to false to build
         the tree as upstream wrote it. Override per build with -p:UseCustomChanges=false -->
    <UseCustomChanges Condition="'$(UseCustomChanges)'==''">true</UseCustomChanges>
    <CustomChangesDefine Condition="'$(UseCustomChanges)'=='true'">USE_CUSTOM_CHANGES;</CustomChangesDefine>
  </PropertyGroup>
  <!-- .NET 9 is hosted through nethost / hostfxr instead of mscoree, so dllmain.cpp needs
       nethost.h, hostfxr.h and coreclr_delegates.h and nethost.dll, which is loaded
       explicitly at runtime rather than linked (see dllmain.cpp for why). They ship in
       the .NET host pack, whose RID has to match the process this DLL is injected into - win-x86,
       because WoW.exe is 32-bit. Override NetHostDir to point at another copy. -->
  <PropertyGroup>
    <NetHostRid Condition="'$(NetHostRid)'=='' And '$(Platform)'=='Win32'">win-x86</NetHostRid>
    <NetHostRid Condition="'$(NetHostRid)'==''">win-x64</NetHostRid>
    <DotNetHostRoot Condition="'$(DotNetHostRoot)'=='' And '$(ProgramW6432)'!=''">$(ProgramW6432)\dotnet</DotNetHostRoot>
    <DotNetHostRoot Condition="'$(DotNetHostRoot)'==''">$(ProgramFiles)\dotnet</DotNetHostRoot>
  </PropertyGroup>
  <ItemGroup>
    <NetHostHeader Include="$(DotNetHostRoot)\packs\Microsoft.NETCore.App.Host.$(NetHostRid)\9.*\runtimes\$(NetHostRid)\native\nethost.h" />
    <NetHostRuntime Include="$(DotNetHostRoot)\packs\Microsoft.NETCore.App.Host.$(NetHostRid)\9.*\runtimes\$(NetHostRid)\native\nethost.dll" />
  </ItemGroup>
  <PropertyGroup>
    <NetHostDir Condition="'$(NetHostDir)'==''">@(NetHostHeader->'%(RootDir)%(Directory)')</NetHostDir>
    <IncludePath>$(NetHostDir);$(IncludePath)</IncludePath>
    <LibraryPath>$(NetHostDir);$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <!-- nethost.dll is loaded explicitly by full path at runtime (see dllmain.cpp), not imported,
       so it still has to sit next to Loader.dll - but a missing one now reports itself instead of
       failing the injection silently. -->
  <Target Name="CopyNetHost" AfterTargets="Build">
    <Copy SourceFiles="@(NetHostRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CheckNetHost" BeforeTargets="ClCompile">
    <Error Condition="'$(NetHostDir)'==''"
           Text="The .NET 9 $(NetHostRid) host pack was not found under $(DotNetHostRoot)\packs\Microsoft.NETCore.App.Host.$(NetHostRid). Install the .NET 9 SDK or pass -p:NetHostDir=&lt;dir containing nethost.h&gt;." />
  </Target>
